# ==============================================================================
# RansomGuard Environment Configuration Template
# Copy this file to .env and configure values before starting services.
# NEVER commit .env to version control.
# ==============================================================================

# Database Configuration
# Default: Local SQLite database (auto-created on startup)
# For PostgreSQL: postgresql://postgres:password@localhost:5432/ransomguard
DATABASE_URL=sqlite:///./ransomguard.db

# JWT Security
# Generate a cryptographically secure random string for production deployments
JWT_SECRET=your-random-32-byte-secret-key-change-in-production
JWT_EXPIRATION_MINUTES=1440

# Backend Service
BACKEND_URL=http://localhost:8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ML & ONNX Inference Engine
MODEL_PATH=./models/ransomware_detector.onnx
SCALER_PATH=./models/scaler.pkl

# Safe Simulation & Containment Boundaries
SIMULATION_DIRECTORY=./scratch/ransim_lab
SAFE_CONTAINMENT_MODE=true
ALERT_THRESHOLD=0.80
CONTAINMENT_THRESHOLD=0.90

# Optional Alerting Integrations (leave blank if unused)
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
